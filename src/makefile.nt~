# compile Java und C Implementation for GUI
!include ..\makent.sw

SUBDIRS = SOUND Utils

SUBMAKE = $(MAKE) -nologo -f makefile.nt

CLASSFILES= SOUND\*.class Utils\*.class

default: $(SUBDIRS)

# subdir targets:
FRC:
#dummy

$(SUBDIRS) :       FRC
	@cd $@ 
	@echo make: Entering directory `$@' 
	$(SUBMAKE) $(ACTION) 
	@cd ..
	@echo make: Leaving directory `$@' 

jar: 	
	copy SOUND\*.class c:\temp\PHS\Sound
	copy Utils\*.class c:\temp\PHS\Utils
	cd c:\temp\PHS
	c:\jshrink\jshrink.exe .
	jar -cvf jcself.jar $(CLASSFILES)
	copy jcself.jar l:\MyProjects\PHS\jcself.jar

clean:
	del SOUND\*.class

source: 	
	jar cvf phs_source_106.jar make* *.bat Sound\*.java Sound\make* Utils\*.java Utils\makefile* 