    int maxGenerator = 7;
    double vibrato1_ampl_min;
    double vibrato1_ampl_max;
    double vibrato1_speed_min;
    double vibrato1_speed_max;
    double vibrato2_ampl_min;
    double vibrato2_ampl_max;
    double vibrato2_speed_min;
    double vibrato2_speed_max; 
