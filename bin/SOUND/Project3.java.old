    int IForm_max;
    int iBand_min; 
    int iBand_max;
    boolean halt = false;

    /**
     * Constructor des 3. Projektes:
     *
     */
    public Project3(CDebug qd, int ver, SoundInfoListener sil) {
	// Constructor
	super(qd, ver, sil);// Ruft den constuctor von Project2 auf !
	debugOut("Project3 : Constructor", 1);
    }
    

    public Vector doKomposition() { // FOF
	String tmp;
	Note nt;
	int n, z, it;
	// Tonal Values:
	double start = 0.0;	// Notenstart
	double dauer;	// Tondauer
	int max_amplitude = getLoundness(this.def.max_amp); // Border values
	int min_amplitude = getLoundness(this.def.min_amp);
	int amplitude = max_amplitude;	// actual value
	double bal = this.balance;
	int generator, envelope = 0;
	Vector komposition = new Vector(); 
	//
	debugOut("KOMPOSITION: (Evolution)", 1);
	// Angangsbedingung:
	int freq;
	if (this.def.seed <= this.def.min_freq) { // do random
	    if (this.def.tonal) freq = (int) getChromaticFrequency();
	    else freq = this.def.min_freq + (int) ((double) (this.def.max_freq - this.def.min_freq) * java.lang.Math.random());
	}
	else if (this.def.tonal) freq = getChromaticFromSeed(this.def.seed);
	else freq = this.def.seed;
	    
	RandomTable rt = new RandomTable(this.qd, this.Verbosity, this.def.min_freq, this.def.max_freq, this.def.interval, 0.0);
	rt.seed = freq;
	// Veraendere die Tabelle:
	// freq, um wieviel nach oben, welche Frequenz-differenz zu beachten ist
	rt.writeNEntrys(freq, this.def.impact, this.def.diff_freq );
	//this.ce.gc.setTable(rt);	// Anzeigen !
	sil.displayRT(rt);
	debugOut("This is our seed :"+freq+" Hz", 5);
	flowControl();
	// Now iterate:
	for (it = 0; it < this.def.iterations; it++) {
	    // Step 1 generate n random Frequencys:
	    rt.iteration = it;// needed for the display 
	    makeNRandomFrequencys(this.def.population, this.def.min_freq, this.def.max_freq); // create Population
	    // Now weight array for each random frequency:
	    makeWeight(this.def.population, rt);// Judge them
	    // now sort it;
	    QSort q = new QSort(); // ( index = max equals the highest weight)
	    q.sort(this.weight, this.freq);
	    if (this.Verbosity >= 6 ) {
		for (z = 0; z < this.def.population; z++) 
		    debugOut("Sorted: index="+z+" freq="+this.freq[z]+" weight="+this.weight[z], 6);
	    }
	    // Next select radomly the fittest:
	    z = (this.def.population -1 ) - (int) ((double) this.def.fittest * java.lang.Math.random());
	    debugOut("Index that will be selected:"+z, 5);
	    freq = this.freq[z];
	    debugOut("This is our new selection:"+freq+" Hz", 5);
	    // Mark the new individual in the RT
	    rt.writeNEntrys( freq, this.def.impact, this.def.diff_freq );
	    sil.displayRT(rt);
	    //this.ce.gc.setTable(rt);	// Anzeigen ! (also find max in RandomTable)
	    //
	    // ----------------- Now modify the properties of this individual: ------------------------
	    //
	    double wght = rt.readEntry(freq);//The new weight from the table
	    debugOut("New weight="+wght, 2);
	    generator = getOszi(wght, rt.max, this.maxGenerator);
	    debugOut("Generator="+generator, 2);
	    amplitude = getAmplitude(wght, rt.max, min_amplitude, 
				     max_amplitude, this.def.amplify_amp);	
	    debugOut("Resulting amplitude ="+amplitude, 5);
	    if (this.def.stereo) bal = getBal(rt.fittest_freq, freq, rt.start, rt.stop);
	    debugOut("Resulting balance: bal="+bal, 5);
	    dauer = getKleiner(wght, rt.max, this.def.min_tempo, this.def.max_tempo);	
	    if (dauer < this.def.min_tempo || dauer > this.def.max_tempo) debugOut("Project2: tempo out of range ="+dauer, 4);
	    nt = new Note(start, dauer, bal, freq, generator, amplitude, envelope);
	    nt.v1a = getKleiner(wght, rt.max, vibrato1_ampl_min, vibrato1_ampl_max);
	    debugOut("Vibrato1 Amp="+nt.v1a, 2);
	    nt.v1s = getKleiner(wght, rt.max, vibrato1_speed_min, vibrato1_speed_max);
	    debugOut("Vibrato1 speed="+nt.v1s, 2);
	    nt.v2a = getKleiner(wght, rt.max, vibrato2_ampl_min, vibrato2_ampl_max);
	    nt.v2s = getKleiner(wght, rt.max, vibrato2_speed_min, vibrato2_speed_max);
	    nt.iband = getIKleiner(wght, rt.max, iBand_min, iBand_max);
	    nt.t1 = getKleiner(wght, rt.max, splitter_t1_min, splitter_t1_max);
	    debugOut("Splitter t1 ="+nt.t1, 2);
	    nt.t2 = getKleiner(wght, rt.max, splitter_t2_min, splitter_t2_max);
	    nt.t3 = getKleiner(wght, rt.max, splitter_t3_min, splitter_t3_max);
	    nt.iokt =  getGreater(wght, rt.max, iOkt_min, iOkt_max);
	    nt.iform = getIKleiner(wght, rt.max, IForm_min, IForm_max);
	    komposition.addElement(nt);
	    start+= dauer;
	    if (this.halt) break;	// stop doing it
	    flowControl();
	}
	return komposition;
    }
    
    /** Select which Oszillor to use :
     */
    public int getOszi(double w, double max, int maxGen) {
	//int z = (int) ((double) (maxGen) * ( (max - w) / max)) ;
	int z = 0;
	return ((Integer) this.generators.elementAt(z)).intValue();
    }
    public void initKomp(Defaults def) {
    //Initialise:
	this.def = def;
	/*this.max_amp = def.max_amp;
	this.min_amp = def.min_amp;
	this.seed = def.seed;
	this.min_freq = def.min_freq;
	this.max_freq = def.max_freq;
	this.step = def.interval;
	this.impact = def.impact;
	this.diff_freq = def.diff_freq;
	this.firstAmount = def.population;
	this.iterations = def.iterations;
	this.toChooseFrom = def.fittest;
	this.amplifier = def.amplify_amp;
	this.stereo = def.stereo;
	this.min_tempo = def.min_tempo;
	this.max_tempo = def.max_tempo;
	this.r_Weight = def.r_Weight;
	this.tonal = false;
	this.balance = 0.5;	// symetrical default
	*/
	// New ones:
	this.vibrato1_ampl_min = def.vibrato1_ampl_min;
	this.vibrato1_ampl_max = def.vibrato1_ampl_max;
	this.vibrato1_speed_min = def.vibrato1_speed_min;
	this.vibrato1_speed_max = def.vibrato1_speed_max;
	this.vibrato2_ampl_min = def.vibrato2_ampl_min;
	this.vibrato2_ampl_max = def.vibrato2_ampl_max;
	this.vibrato2_speed_min = def.vibrato2_speed_min;
	this.vibrato2_speed_max = def.vibrato2_speed_max; 
	this.iOkt_min = def.iOkt_min;
	this.iOkt_max = def.iOkt_max;
	this.splitter_t1_min = def.splitter_t1_min;
	this.splitter_t1_max = def.splitter_t1_max;
	this.splitter_t2_min = def.splitter_t2_min;
	this.splitter_t2_max = def.splitter_t2_max;
	this.splitter_t3_min = def.splitter_t3_min; 
	this.splitter_t3_max = def.splitter_t3_max;
	this.IForm_min = def.IForm_min;
	this.IForm_max = def.IForm_max;
	this.iBand_min = def.iBand_min; 
	this.iBand_max = def.iBand_max;
    }
    /**
     * Hier nun das Herz der Methode: wie baut man eine Ton-Abfolge.
     * Das Ergebnis ist ein Vector mit den .sco Zeilen für die Töne.
     * @param parm ein Übergabeparameter, kann auch leer sein (vom Textfeld)
     * @return Vector with .sco lines
     */
    public Vector generateSound(Defaults def) {
	Vector komposition;
	Note nt;
	String tmp = "";
	Vector result = new Vector();
	initKomp(def);
	if (this.def.tonal) createNoteTable(this.note_mode);
	komposition = doKomposition();	// Evolution
	// ----------------------------------------------------------
	// so macht man dann aus einem Note - Eintrag eine sco-line :
	for(int n = 0; n < komposition.size(); n++) {
	    nt = (Note) komposition.elementAt(n);
	    tmp = "";
	    if (nt.generator > 0) tmp += "i"+nt.generator; // i1-i7
	    tmp += "\t"+Converter.formatDouble(nt.start, 10)+"\t"+Converter.formatDouble(nt.dauer, 10); // time
	    if (nt.amplitude >= 0) tmp+= "\t"+nt.amplitude; // Aplitude
	    if (nt.freq >= 0) tmp+= "\t"+nt.freq; // Frequenz
	    if (nt.v1a >= 0.0) tmp+= "\t"+Converter.formatDouble(nt.v1a, 8,4); // Vibrato1 ampl
	    if (nt.v1s >= 0.0) tmp+= "\t"+Converter.formatDouble(nt.v1s, 8,4); // Vibrato1 ampl
	    if (nt.iform >= 0) tmp+= "\t"+nt.iform; // IForm
	    if (nt.v2a >= 0.0) tmp+= "\t"+Converter.formatDouble(nt.v2a, 8,4); // Vibrato2 ampl
	    if (nt.v2s >= 0.0) tmp+= "\t"+Converter.formatDouble(nt.v2s, 8,4); // Vibrato2 ampl
	    if (nt.iokt >= 0.0) tmp+= "\t"+Converter.formatDouble(nt.iokt, 8,4); // Oktave
	    if (nt.iband >= 0) tmp+= "\t"+nt.iband; // Iband
	    if (nt.t1 >= 0.0) tmp+= "\t"+Converter.formatDouble(nt.t1, 10,8); // time1
	    if (nt.t2 >= 0.0) tmp+= "\t"+Converter.formatDouble(nt.t2, 10,8); // time1
	    if (nt.t2 >= 0.0) tmp+= "\t"+Converter.formatDouble(nt.t2, 10,8); // time1
	    tmp+= "\t"+"3 7 2 7 5 4 5";// Table
	    tmp+= "\t"+"1";// Mod
	    if (nt.balance > 0 ) tmp+= "\t"+Converter.formatDouble(nt.balance, 8,3);
	    result.addElement(tmp);
	    debugOut("add line:"+tmp, 6);
	}
	return result;
    }

    /**
     * The .orc file
     */
    public Vector getOrc() {
	Vector orc = new Vector();
	orc.addElement(";Orc file*********************************************");
	orc.addElement("nchnls = 2");

	orc.addElement("instr 1 ; fof- File");

	orc.addElement("itotdur = p3");
	orc.addElement("iamp = p4 ; Lautstärke");
	orc.addElement("ifund = p5 ; Frequenz");
	orc.addElement("ifundvibdepth = p6 ;");
	orc.addElement("ifundvibrate = p7 ;");
	orc.addElement("iform = p8  ;");
	orc.addElement("iformvibdepth = p9 ;");
	orc.addElement("iformvibrate = p10 ;");
	orc.addElement("ioct = p11 ;");
	orc.addElement("iband = p12 ;");
	orc.addElement("iris = p13 ;");
	orc.addElement("idur = p14  ;");
	orc.addElement("idec = p15 ;");

	orc.addElement("ifna = 18");
	orc.addElement("ifnb = 19");
	orc.addElement("if1 = p16 ;");
	orc.addElement("if2 = p17 ;");
	orc.addElement("if3 = p18 ;");
	orc.addElement("if4 = p19 ;");
	orc.addElement("if5 = p20 ;");
	orc.addElement("if6 = p21 ;");
	orc.addElement("if7 = p22 ;");
	orc.addElement("ifmod = p23 ;  0 / non-0");
	orc.addElement("iphs = 0");
	orc.addElement("iolaps = 30000 ;int((ifund+1)*(iris+idur+idec))+1");
	orc.addElement("irate    = p24");	
	orc.addElement("aenv  oscili    iamp, 1/itotdur, if1");
	orc.addElement("afund oscili    ifund, 1/itotdur, if2");
	orc.addElement("afundvib oscili ifundvibdepth, ifundvibrate, if3");
	orc.addElement("aform oscili    iform, 1/itotdur, if4");
	orc.addElement("aformvib oscili iformvibdepth, iformvibrate, if5");
	orc.addElement("kokt  oscili    ioct, 1/itotdur, if6");
	orc.addElement("kband oscili    iband, 1/itotdur, if7");


	orc.addElement("ain  fof aenv, afund+afundvib, aform+aformvib, kokt, kband, iris, idur,idec, iolaps, ifna, ifnb, itotdur, iphs, ifmod");

	orc.addElement("; Panning");
	orc.addElement("klfo1 expon (1-irate), p3, irate");
	orc.addElement("klfo2 expon irate, p3, (1-irate)");
	orc.addElement("ain      = ain*klfo2");
	orc.addElement("al       = ain*sqrt(klfo1)");
	orc.addElement("ar       = ain*sqrt(1 - klfo1)");
	orc.addElement("kenv linseg 0, 0.005*p3, 1, 0.99*p3, 1, 0.005*p3, 0");

	orc.addElement("outs     al*kenv, ar*kenv");

	orc.addElement("endin");

	return orc;
    }
    
    public Vector getHeader() {
	String tmp;
	int n;
	int generator1 = 1;
	int tempo = 150;
	// 7 Generators !
	this.generators = new Vector();
	for (n = 0; n < maxGenerator; n++) this.generators.addElement(new Integer(n+1));
	Vector header = new Vector();
	
	header.addElement("***************************************** ");
	header.addElement("f1   0   1024   7  1 1024 1 ; bypass");
	header.addElement("f2   0   1024   7  0 1024 1 ; lin hoch");
	header.addElement("f3   0   1024   7  1 1024 0 ; lin runter");
	header.addElement("f4   0   1024   5  .001 1024 1 ; exp hoch");
	header.addElement("f5   0   1024   5  1 1024 .001 ; exp runter");
	header.addElement("f6   0   1024   7  1 256 0 256 1 256 0 256 1 ; zicke-zacke");
	header.addElement("f7   0   1024   7  0 256 1 256 0 256 1 256 0");
	header.addElement("f18  0   4096  10  1");
	header.addElement("f19  0   1024  19   .5   .5   270   .5");

	header.addElement(";t,          Vel  Freq    Vib Vspeed  iform  Vib  ioct     iband SplitterTime      Tabellen  Vib  Tab  Mod   Balance");

	return header;
    }
}// end of class







